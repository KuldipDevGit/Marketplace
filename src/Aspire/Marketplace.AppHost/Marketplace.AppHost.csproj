<Project Sdk="Aspire.AppHost.Sdk/13.4.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a0d73e17-3370-4e0b-97b8-2bbbb778db30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup Label="Infrastructure integrations (ADR-0005, ADR-0008)">
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
  </ItemGroup>

  <ItemGroup Label="Service projects">
    <ProjectReference Include="..\..\Services\Catalog\Marketplace.Catalog.Api\Marketplace.Catalog.Api.csproj" />
    <ProjectReference Include="..\..\Services\Pricing\Marketplace.Pricing.Api\Marketplace.Pricing.Api.csproj" />
  </ItemGroup>

  <ItemGroup Label="Security audit exception (SEC-15)">
    <!--
      MessagePack 2.5.192 (high severity, GHSA-hv8m-jj95-wg3x) arrives transitively via the
      Aspire dev-host tooling. The only fix is MessagePack 3.x, a major bump that risks the
      Aspire dashboard/DCP at runtime. The AppHost is a LOCAL orchestrator and is NOT shipped
      to production, so this is not a shipped CVE. Full NuGet audit remains enabled everywhere
      else (including the shipped services). Tracked by Dependabot; remove this once Aspire
      bumps its MessagePack pin.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-hv8m-jj95-wg3x" />
  </ItemGroup>

</Project>
