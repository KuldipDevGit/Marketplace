<Project>

  <!-- Inherit the solution-wide settings, then relax rules that conflict with test conventions. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: underscores in test names; CA1515: public test classes; CA1062: arg null-checks. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1062</NoWarn>
  </PropertyGroup>

</Project>
